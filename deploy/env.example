# Settings of a machine that is not the laptop: the VPS or the phone (docs/remote.md).
#
# Copy to .env at the repo root (git-ignored), then `chmod 600 .env`. deploy/brief.sh reads it as a shell would:
# no spaces around `=`, and the JSON value stays inside its single quotes.

# The model: Venice's hosted Qwen 3.5 9B, the model the prompts were tuned on.
XMD_LLM_BASE_URL=https://api.venice.ai/api/v1
XMD_LLM_MODEL=qwen3-5-9b
XMD_LLM_API_KEY=
# Thinking off (the brief's token budgets assume it) and none of Venice's own system prompt.
XMD_LLM_EXTRA_BODY='{"venice_parameters":{"disable_thinking":true,"include_venice_system_prompt":false}}'

# The X backend's key, unless sources.yaml holds it already (XMD_TWITTERAPI_KEY for twitterapi.io).
#XMD_TWEETAPI_KEY=

# The phone only. Where a brief ends up: one made on the phone is copied there, one made on the VPS is
# downloaded there. Any folder the Files app can see, or one inside your vault. Unset, the phone uses this one:
#XMD_BRIEF_DEST="$HOME/storage/shared/Documents/xmd-briefs"
# The phone only: the VPS, as named in ~/.ssh/config.
#XMD_VPS_HOST=xmd-vps

# After each run, delete the briefs and digests older than this many days (unset: keep them). Exports and runs are
# deleted by every fetch whatever this says (EXPORT_KEEP_DAYS in xmd/cli.py).
#XMD_KEEP_DAYS=14

# The VPS: the ntfy topic told when a brief is ready or a run failed (unset: no notification). The name is the
# topic's password: a long random one (docs/remote-setup.md, step 3.5), the same in the phone's ntfy app.
#XMD_NOTIFY_URL=https://ntfy.sh/PUT_A_LONG_RANDOM_NAME_HERE
